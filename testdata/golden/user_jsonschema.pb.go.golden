	if _, ok := defs["users.v1.ConstraintDemo"]; ok {
		return &jsonschema.Schema{Ref: "#/$defs/users.v1.ConstraintDemo"}
	}

	schema := &jsonschema.Schema{
		Type:        "object",
		Description: "ConstraintDemo exercises every jsonschema constraint option that maps\n to a pointer-typed field in github.com/google/jsonschema-go. Regression\n coverage for the pointer-type fix.",
		Properties:  make(map[string]*jsonschema.Schema),
		Required: []string{
